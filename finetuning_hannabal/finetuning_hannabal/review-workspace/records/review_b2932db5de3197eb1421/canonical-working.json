      "text": "- أما الملكية التامة فتنتقل إليه باستيفاء إجراء الإشهار العقاري طبقا لنص المادة 793 من القانون المدني وللأحكام المنصوص عليها في المرسوم رقـم 76/63 المؤرخ في 25مارس1976 المتضمن تأسيس السجل العقـاري المعدل والمتمم بالمرسوم التنفيـذي رقم123/93 المـؤرخ في19 ماي 1993./ـــــــــ"
    },
    {
      "content_id": "unparsed_d84ac2fcf1c0922a4344",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000023",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 2,
        "normalized_start": 0,
        "raw_end": 2,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "764c8a3561c7cf261771b4e1969b84c210836f3c034baebac5e49a394a6ee0a9"
      },
      "text": "\u0001\u0015"
    },
    {
      "content_id": "unparsed_5b7034e613b6c7b677eb",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000024",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 213,
        "normalized_start": 0,
        "raw_end": 213,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "cd64d58fe27b9c5f9892549f2ee1a0a41470e8bcc7bc2ffd48db1e3da3c0af95"
      },
      "text": "تم هذا البيع وقبل به الطرفان وفق التكاليف والشروط العادية والقانونية الجارية في مثل هذا الشأن والمنصوص عليها في القانون المدني لاسيما التالية التي التزم المشتري بتنفيذها وأدائها وهــي:/----------------------------"
    },
    {
      "content_id": "unparsed_2cf852ca51b5d89bcef3",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000025",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 189,
        "normalized_start": 0,
        "raw_end": 189,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "2eb4d62bdf95aadc08b21e119e16d2cb8a79cd428ce7e32d2e17e4fbde14019d"
      },
      "text": "- يلتزم المشتـري بتسلـم العقار المبـاع على حالته الراهنة من غير أن يكون له حـق الرجوع على البائع في جميع الحالات إلا مـا ورد فـي نص صريح من القانون المدني./ـــــــــــــــــــــــــــــــــ"
    },
    {
      "content_id": "unparsed_b43877abcaf041dd486a",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000026",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 429,
        "normalized_start": 0,
        "raw_end": 429,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "ef94132c9544b681ed193d2bd8a939b984272eeb9b475403f9026d485efa09b7"
      },
      "text": "- يتحمل المشتري جميع حقوق الارتفاق المترتبة على العقار المباع حاليا مهما كـان نوعها الظاهرة منها أو الباطنـة الجاريـة أو المتوقفة ما لم يعارض فيها وينتفع بالمقابل بتلك الإيجابية والنافعة إن وجدت كل ذلك تحت مسؤوليته من غير رجوع على البائع لأي سبب كان ومن دون أن يمنح هذا الشرط لأي كان حقوقا أكثر مما يستحق بموجب وثائق رسمية لم تسقط بالتقادم أو بحكـم القانون ومن غير أن يضر هذا الشرط بالحقوق الناتجة للمشتري بموجب هذا العقـد./ـــــ"
    },
    {
      "content_id": "unparsed_a49dc25310f1731b4595",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000027",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 152,
        "normalized_start": 0,
        "raw_end": 152,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "c0289a6c392a86e0a78631776e0f68ec771ba6689c0480e1f11a37bffb2536d9"
      },
      "text": "- يتحمل المشتري سائر المصاريف والحقوق والأتعاب التوثيقية المترتبة على هذا العقد وتوابعه القانونية والعادية، ماعدا التي هي على البائع بمقتضى القانون./ـــ"
    },
    {
      "content_id": "unparsed_6ec12ee1dff097f84390",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000028",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 2,
        "normalized_start": 0,
        "raw_end": 2,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "764c8a3561c7cf261771b4e1969b84c210836f3c034baebac5e49a394a6ee0a9"
      },
      "text": "\u0001\u0015"
    },
    {
      "content_id": "unparsed_13b1f4d13bc821c3ab4d",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000029",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 125,
