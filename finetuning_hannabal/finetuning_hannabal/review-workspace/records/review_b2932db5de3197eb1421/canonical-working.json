        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "764c8a3561c7cf261771b4e1969b84c210836f3c034baebac5e49a394a6ee0a9"
      },
      "text": "\u0001\u0015"
    },
    {
      "content_id": "unparsed_802ea81dba81b5c28eca",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000034",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 215,
        "normalized_start": 0,
        "raw_end": 215,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "9fd47527e4a1a248f09a57cd353fcb2136fe1520204cb03d8d57777392cfd8b4"
      },
      "text": "صرح البائع وتحت مسؤوليته أنه من جنسية جزائرية وأنه كامل الحقوق المدنية التي تخول له القيام بالتصرفات القانونية وأنه لم يتعرض لأية عقوبة أو تدابير أمن تحد من حريته وصرح بأن العقار بيع وهو صاف من كل ديـن وتبعية./ـــــ"
    },
    {
      "content_id": "unparsed_d891dab10b1e9edd7b18",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000035",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 2,
        "normalized_start": 0,
        "raw_end": 2,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "764c8a3561c7cf261771b4e1969b84c210836f3c034baebac5e49a394a6ee0a9"
      },
      "text": "\u0001\u0015"
    },
    {
      "content_id": "unparsed_7167e80623f4ae442b88",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000036",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 135,
        "normalized_start": 0,
        "raw_end": 135,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "dba7d3702f89a45124ee04ffa13c0496472d67d99f5507ef35a23f2b7e1f15c7"
      },
      "text": "في الحين سلـم البائع للمشتري المعترف بذالك نسخة من سنـد الملكية المحلل أعلاه وجميع توابعه وأبرئت بذالك ذمة البائـع منـه./ــــــــــــــ"
    },
    {
      "content_id": "unparsed_c602be703c286088a5b3",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000037",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 2,
        "normalized_start": 0,
        "raw_end": 2,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "764c8a3561c7cf261771b4e1969b84c210836f3c034baebac5e49a394a6ee0a9"
      },
      "text": "\u0001\u0015"
    },
    {
      "content_id": "unparsed_56cd0fe4cab5592a2d75",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000038",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 365,
        "normalized_start": 0,
        "raw_end": 365,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "815fe22813152014970ae1e43da66ccbc7615f5eaa9934634385b5e8e46ad579"
      },
      "text": "وقبل إتمام هذا العقد تـلا الموثـق على الطرفين نص المواد {113 و114 و118 و119 و133 و134} من قانون التسجيل وبعد استفسارهما من طرف الموثق الموقع أدناه أكد الطرفان تحت طائلة العقوبات المنصوص عليها في المادة 134 من قانون التسجيل وأن هذا العقـد يتضمن القيمة الحقيقية للعقار المباع وأن الموثق لا يعلم بأن هذا العقد وقع فيه تعديل بسند مضاد يتضمن زيادة في الثمن./ــــــــــــ"
    },
    {
      "content_id": "unparsed_c3f14503632e2c42e9d2",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000039",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 288,
        "normalized_start": 0,
        "raw_end": 288,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "d7320ebfa4af9bbe5244f46df7b9ef0c1605053f8e2a1efbe24d6d530a98311d"
      },
      "text": "*- وتلا عليهما محتويات المواد:57 ومن:123 إلى: 127 والمادة:303 من قانون الضرائب المباشرة والرسوم المماثلة المعدلة بالمادة: 28 من القانون رقم 02-11 المؤرخ في: 24ديسمبر2002 المتضمن قانون المالية لسنة 2003 وبالمادة 13 من قانون رقم11-16 المؤرخ في28ديسمبر2011 والمتضمن قانون المالية لسنة2012./ـ"
    },
    {
      "content_id": "unparsed_3e0bbcb14b67761bd6d1",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000040",
        "extraction_id": "ext_d82f40ebdf024625d56b",
        "normalized_end": 590,
        "normalized_start": 0,
        "raw_end": 590,
        "raw_start": 0,
        "source_id": "src_913cdef8d9e57fb09db9",
        "text_sha256": "4da650c48240463c821cf92767d1a9a7d23c81bf2fdf83157d0bb81c3f118e34"
      },
      "text": "وعليه شهـد وأكـد الطرفان المتعاقدان تحت طائلة العقوبات المنصوص عليها في المادة 119 و134 من قانون التسجيل بأن هذا العقـد يعبر عن كامل الثمن المتفق عليه والمصرح به أعلاه وأنه لا يوجد أي انتقاص أو تخفيض فيه وأشهد الموثق الممضي أسفله من جهته بأنه ليس في علمه بأن هذا العقـد وقع فيه التعديل بمستند مضاد يتضمن الزيادة في الثمن المصرح به أعلاه وأخيرا ألفت الموثق الممضي أسفله انتباه الطرفين المتعاقدين كما هما قائمان وتلا عليهما محتويات المواد 91، 107، 112 من قانون التسجيل الخاصة بتضامن من الطرفين المتعاقدين بينهما في اداء حقوق التسجيل والعقوبات في حالة وجود نقص في الثمن المصرح أعلاه./ـــــــــ"
    },
