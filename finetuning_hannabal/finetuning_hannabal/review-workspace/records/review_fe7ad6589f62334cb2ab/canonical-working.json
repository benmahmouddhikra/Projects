    {
      "clauses": [
        {
          "clause_id": "clause_e960f40433125d8f0ed1",
          "clause_type": "unclassified",
          "condition": null,
          "heading": "5. TRAINING, RECORD-KEEPING, AND REVIEW",
          "legal_references": [],
          "order": 1,
          "requirement_status": "unspecified",
          "source_span": {
            "block_id": "block_000002",
            "extraction_id": "ext_bea85b6a2483b76bf6bf",
            "normalized_end": 3288,
            "normalized_start": 2454,
            "raw_end": 3288,
            "raw_start": 2454,
            "source_id": "src_5bda226150d98eb351a0",
            "text_sha256": "c5a46059a585be96109158f4ce281d874b7f8361177bc8f6fdce04f1324eb072"
          },
          "text": "All employees receive AML-CFT training upon joining the Company and\n[REVIEW_PERIOD]\nthereafter. Training covers the relevant provisions of Federal Decree-Law No. 20 of 2018, the\nAML-CFT Executive Regulations, the Company's internal procedures, how to recognise the signs of\nmoney laundering and terrorist financing, reporting obligations, and the tipping-off prohibition.\nSenior management and the MLRO receive enhanced training appropriate to their responsibilities.\nThe Company maintains records of all CDD documentation, transaction records, and STR files for a\nminimum of five years. This Policy is reviewed\n[REVIEW_PERIOD]\nby\n[MLRO_NAME]\nand updated to reflect changes in UAE law, FATF guidance, or the Company's risk profile. The\nreview considers the findings of any regulatory inspection by the Ministry of Economy, the Central",
          "variable_ids": [
            "mlro_name",
            "review_period"
          ]
        }
      ],
      "condition": null,
      "heading": "5. TRAINING, RECORD-KEEPING, AND REVIEW",
