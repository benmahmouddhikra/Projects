    {
      "clauses": [
        {
          "clause_id": "clause_2178ffd31d554157f01f",
          "clause_type": "unclassified",
          "condition": null,
          "heading": "3. CUSTOMER DUE DILIGENCE",
          "legal_references": [],
          "order": 1,
          "requirement_status": "unspecified",
          "source_span": {
            "block_id": "block_000002",
            "extraction_id": "ext_bea85b6a2483b76bf6bf",
            "normalized_end": 1343,
            "normalized_start": 26,
            "raw_end": 1343,
            "raw_start": 26,
            "source_id": "src_5bda226150d98eb351a0",
            "text_sha256": "4b153133cf7f2efd5a8135abe087671d928d24672e14c578cfb3e92fc39bfd13"
          },
          "text": "The Company applies Customer Due Diligence (CDD) measures before establishing a business\nrelationship or carrying out an occasional transaction above the applicable threshold. CDD\nmeasures include: identifying and verifying the customer's identity using reliable, independent\nsource documents — Emirates ID, passport, trade licence, or Memorandum of Association as\napplicable; identifying the ultimate beneficial owner (UBO) in accordance with the UAE UBO\nRegulation, Cabinet Resolution No. 58 of 2020, and verifying the UBO's identity; understanding the\nnature and purpose of the business relationship; and conducting ongoing monitoring of the\nbusiness relationship.\nFor customers who are legal persons or legal arrangements, the Company identifies and verifies\nthe identity of all natural persons who own or control the legal person — including any person who\nowns or controls more than 25% of the legal person's shares or voting rights — as required by the\nUBO Regulation and the AML-CFT Executive Regulations. The MLRO,\n[MLRO_NAME]\n, oversees the CDD programme and reviews CDD files for high-risk customers. All CDD records are\nretained for a minimum of five years from the end of the business relationship or the date of the\noccasional transaction, as required by Article 25 of Federal Decree-Law No. 20 of 2018.",
          "variable_ids": [
            "mlro_name"
          ]
        }
      ],
      "condition": null,
      "heading": "3. CUSTOMER DUE DILIGENCE",
      "heading_span": {
        "block_id": "block_000002",
