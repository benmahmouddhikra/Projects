    {
      "clauses": [
        {
          "clause_id": "clause_254077ef0be4e0e5b44c",
          "clause_type": "unclassified",
          "condition": null,
          "heading": "4. SUSPICIOUS TRANSACTION REPORTING",
          "legal_references": [],
          "order": 1,
          "requirement_status": "unspecified",
          "source_span": {
            "block_id": "block_000002",
            "extraction_id": "ext_bea85b6a2483b76bf6bf",
            "normalized_end": 2413,
            "normalized_start": 1380,
            "raw_end": 2413,
            "raw_start": 1380,
            "source_id": "src_5bda226150d98eb351a0",
            "text_sha256": "a108dd6a145bd2d2adf30a714e5ab7c854ccd1949f4f148de9cdbe8115503c59"
          },
          "text": "All employees are required to report any suspicion of money laundering, terrorist financing, or\nrelated predicate offences — including bribery and corruption under the UAE Penal Code, Federal\nDecree-Law No. 31 of 2021 — to the MLRO at\n[MLRO_CONTACT]\npromptly and without alerting the customer or the subject of the suspicion (tipping-off prohibition\nunder Article 17 of Federal Decree-Law No. 20 of 2018). The MLRO will assess the internal report\nand, where there is reasonable grounds for suspicion, file a Suspicious Transaction Report (STR)\nor Suspicious Activity Report (SAR) with the UAE Financial Intelligence Unit via the goAML portal.\nEmployees must not warn the customer that an STR has been filed or is being considered. Tipping\noff is a criminal offence under UAE law. Employees who report suspicious activity in good faith are\nprotected from civil and criminal liability by Article 17 of Federal Decree-Law No. 20 of 2018. The\nMLRO maintains a register of all internal reports received and the outcome of each assessment.",
          "variable_ids": [
            "mlro_contact"
          ]
        }
      ],
      "condition": null,
      "heading": "4. SUSPICIOUS TRANSACTION REPORTING",
