    {
      "clauses": [
        {
          "clause_id": "clause_ac192a01c747b95d0ef5",
          "clause_type": "unclassified",
          "condition": null,
          "heading": "2. RISK ASSESSMENT AND RISK-BASED APPROACH",
          "legal_references": [],
          "order": 1,
          "requirement_status": "unspecified",
          "source_span": {
            "block_id": "block_000001",
            "extraction_id": "ext_bea85b6a2483b76bf6bf",
            "normalized_end": 2553,
            "normalized_start": 1537,
            "raw_end": 2553,
            "raw_start": 1537,
            "source_id": "src_5bda226150d98eb351a0",
            "text_sha256": "c05e03299dcf86c52924e087b0fc206520473c1559b94a7aedf5496061c17bad"
          },
          "text": "The Company has conducted a Business Risk Assessment in accordance with Article 16 of the\nAML-CFT Executive Regulations, Cabinet Decision No. 10 of 2019. The overall AML-CFT risk\nrating of the Company is:\n[RISK_RATING]\n. The Business Risk Assessment evaluates risk across four dimensions: customer risk (including\npolitically exposed persons, non-resident customers, and high-risk nationalities); product and\nservice risk; geographic risk; and delivery channel risk. The assessment is reviewed\n[REVIEW_PERIOD]\nor whenever the Company's business activities change materially.\nThe Company applies a risk-based approach as required by the FATF Recommendations.\nEnhanced Due Diligence is applied to high-risk customers, transactions, and business relationships\n— including customers classified as politically exposed persons under the PDPL and the AML-CFT\nExecutive Regulations. Simplified Due Diligence may be applied where the risk is demonstrably\nlow, subject to the restrictions in the AML-CFT Executive Regulations.",
          "variable_ids": [
            "review_period",
            "risk_rating"
          ]
        }
      ],
      "condition": null,
      "heading": "2. RISK ASSESSMENT AND RISK-BASED APPROACH",
      "heading_span": {
        "block_id": "block_000001",
