        {
          "clause_id": "clause_9d26a1c3fd12796c90d0",
          "clause_type": "unclassified",
          "condition": null,
          "heading": "1. COMMITMENT AND LEGAL BASIS",
          "legal_references": [],
          "order": 1,
          "requirement_status": "unspecified",
          "source_span": {
            "block_id": "block_000001",
            "extraction_id": "ext_bea85b6a2483b76bf6bf",
            "normalized_end": 1493,
            "normalized_start": 260,
            "raw_end": 1493,
            "raw_start": 260,
            "source_id": "src_5bda226150d98eb351a0",
            "text_sha256": "5bc7f965b12d75621f916b3ba6e528ef6188e8ff7dc2196d43d1e13aed9e54a2"
          },
          "text": "[COMPANY_NAME]\n(the 'Company') is committed to the highest standards of Anti-Money Laundering (AML) and\nCounter-Terrorist Financing (CTF) compliance. The Company operates as a\n[ENTITY_TYPE]\nand is subject to the Anti-Money Laundering and Combating the Financing of Terrorism Law —\nFederal Decree-Law No. 20 of 2018, as amended by Federal Decree-Law No. 26 of 2021 — and\nthe AML-CFT Executive Regulations, Cabinet Decision No. 10 of 2019. The Company recognises\nthe UAE's National Action Plan for AML-CFT compliance and its obligations under the Financial\nAction Task Force (FATF) standards, to which the UAE is committed as a FATF member.\nThis Policy applies to all employees, directors, managers, agents, and contractors of the Company.\nIt covers the Company's customer due diligence programme, transaction monitoring, Suspicious\nTransaction Reporting to the UAE Financial Intelligence Unit, employee training, and\nrecord-keeping obligations. Non-compliance with this Policy or with applicable AML-CFT law is a\nserious disciplinary matter and may constitute a criminal offence under Federal Decree-Law No. 20\nof 2018, which provides for imprisonment of up to ten years and fines of up to AED 5 million for\nmoney laundering offences.",
          "variable_ids": [
            "company_name",
            "entity_type"
          ]
        }
      ],
      "condition": null,
      "heading": "1. COMMITMENT AND LEGAL BASIS",
      "heading_span": {
        "block_id": "block_000001",
        "extraction_id": "ext_bea85b6a2483b76bf6bf",
        "normalized_end": 259,
