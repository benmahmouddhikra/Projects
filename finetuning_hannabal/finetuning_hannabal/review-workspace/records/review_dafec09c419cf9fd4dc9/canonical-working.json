          "condition": null,
          "heading": "2010  ( ﻟﻌﺎم17) وﻓﻖ أﺣﻜﺎم ﻗﺎﻧﻮن اﻟﻌﻤﻞ اﻟﺴﻮري رﻗﻢ",
          "legal_references": [],
          "order": 1,
          "requirement_status": "unspecified",
          "source_span": {
            "block_id": "block_000001",
            "extraction_id": "ext_847b482dccf60cc0448e",
            "normalized_end": 1423,
            "normalized_start": 97,
            "raw_end": 1423,
            "raw_start": 97,
            "source_id": "src_9cbb508bb34760770e6f",
            "text_sha256": "8052d91cc99d1bfcc434dee43008b21376e0817c958f01ff8903fd7cac84d0a6"
          },
          "text": "اﻟﻄﺮف اﻷول: ﺑﺎﺳﻢ اﻟﺸﺮﻛﺔ أو اﻟﻤﺆﺳﺴﺔ واﻟﻤﻔﻮض ﺑﺎﻟﺘﻮﻗﯿﻌﻌﻨﻬﺎ اﻟﻤﺪﯾﺮ اﻟﻌﺎم ﺑﺤﻤﻞ اﻟﺒﻄﺎﻗﺔ اﻟﺸﺨﺼﯿﺔ  \nاﻟﺼﺎدرة ﻋﻦ أﻣﺎﻧﺔ اﻟﺴﺠﻞ ...... اﻟﻌﺎم ﺑﺘﺎرﯾﺦ// \nرﻗﻤﻪ اﻟﻮﻃﻨﻲ .......... اﻟﻤﺪﻧﻲ................  \nاﻟﻌﻨﻮان ﻓﻲ ﻣﻌﺮض ﺗﻨﻔﯿﺬ ﻫﺬا اﻟﻌﻘﺪ. \nاﻟﻄﺮف اﻟﺜﺎﻧﻲ: .............. ﻣﻦ اﻟﺠﻨﺴﯿﺔ اﻟﻌﺮﺑﯿﺔ اﻟﺴﻮرﯾﺔ وﯾﺤﻤﻞ اﻟﺒﻄﺎﻗﺔ اﻟﺸﺨﺼﯿﺔ ............  \nاﻟﺼﺎدرة ﻋﻦ أﻣﺎﻧﺔ اﻟﺴﺠﻞ اﻟﻤﺪﻧﻲ ﻓﻲ ................ ﺑﺘﺎرﯾﺦ// \nاﻟﻌﻨﻮان ﻓﻲ ﻣﻌﺮض ﺗﻨﻔﯿﺬ ﻫﺬا اﻟﻌﻘﺪ\nﻣﻘﺪﻣﺔ اﻟﻌﻘﺪ\nﻟﻤﺎ ﻛﺎن اﻟﻔﺮﯾﻖ اﻷول ﺑﺼﻔﺘﻪ اﻟﻤﺒﯿﻨﺔ آﻧﻔﺎً، ﯾﺮﻏﺐ ﺑﺎﻟﺘﻌﺎﻗﺪ ﻣﻊ اﻟﻔﺮﯾﻖ اﻟﺜﺎﻧﻲ ﻟﻠﻌﻤﻞ ﻓﻲ اﻟﻤﻨﺸﺄة اﻟﻤﺬﻛﻮرة،  \nوﻛﺎن اﻟﻔﺮﯾﻖ اﻟﺜﺎﻧﻲ ﯾﺮﻏﺐ ﺑﺬﻟﻚ ﺑﻤﻬﻨﺔ )( وﻗﺪ اﻃﻠﻊ اﻟﻔﺮﯾﻖ اﻟﺜﺎﻧﻲ ﻋﻠﻰ اﻧﻈﻤﺔ اﻟﻌﻤﻞ اﻟﻨﺎﻓﺬة ﻟﺪﯾﻬﺎ وﻗﺒﻞ  \n/ب ﻣﻦ ﻗﺎﻧﻮن اﻟﻌﻤﻞ اﻟﺴﻮري( 4 ﺑﻬﺎ )ﻣﻊ ﻣﺮاﻋﺎة أﺣﻜﺎم اﻟﻤﺎدة. \nاﺗﻔﻖ اﻟﻔﺮﯾﻘﺎن ﻋﻠﻰ ﻣﺎ ﯾﻠﻲ: \n- ﺗﻌﺘﺒﺮ ﻣﻘﺪﻣﺔ ﻫﺬا اﻟﻌﻘﺪ ﺟﺰء ﻻ ﯾﺘﺠﺰأ ﻣﻨﻪ 1- ﻣﺎدة.\n- ﺗﺒﺪأ ﻣﺪة ﻫﺬا اﻟﻌﻘﺪ ﺑﺘﺎرﯾﺦ//وﺗﻨﺘﻬﻲ ﺑﺘﺎرﯾﺦ 2- ﻣﺎدة//\n- ﺗﻌﺘﺒﺮ اﻟﺜﻼﺛﺔ اﺷﻬﺮ اﻷوﻟﻰ ﻣﻦ ﻋﻤﻞ اﻟﻄﺮف اﻟﺜﺎﻧﻲ ﻣﺪة اﺧﺘﺒﺎر ﻻ ﯾﺠﻮز ﺗﻜﺮارﻫﺎ أو زﯾﺎدﺗﻬﺎ 3- ﻣﺎدة \nوﻟﻜﻞ ﻣﻦ اﻟﻄﺮﻓﯿﻦ إﻧﻬﺎء اﻟﻌﻘﺪ ﺧﻼل ﻫﺬه اﻟﻤﺪة دون أي إﺧﻄﺎر ﻣﺴﺒﻖ أو اﻟﺘﺰام ﺑﺘﻌﻮﯾﺾ وﻻ ﯾﺘﺮﺗﺐ  \nﻋﻠﻰ اﻟﻄﺮف اﻷول أي ﻣﺴﺆوﻟﯿﺔ ﻓﻲ ﺣﺎل إﻧﻬﺎء اﻟﻌﻘﺪ ﺧﻼل اﻟﻤﺪة اﻟﻤﺬﻛﻮرة. \n- )أ(- اﺗﻔﻖ اﻟﻄﺮﻓﺎن ﻋﻠﻰ ﺗﺤﺪﯾﺪ اﻷﺟﺮ اﻟﺸﻬﺮي ﻟﻠﻄﺮف اﻟﺜﺎﻧﻲ ﺑﻤﺒﻠﻎ وﻗﺪره )( ﻟﯿﺮة ﺳﻮرﯾﺔ 4- ﻣﺎدة \nﯾﺘﻘﺎﺿﺎه ﻓﻲ ﻣﻜﺎن ﻋﻤﻠﻪ ﺧﻼل ﺳﺎﻋﺎت اﻟﺪوام اﻟﺮﺳﻤﻲ ﻓﻲ ﻣﻮﻋﺪ ﻻ ﯾﺘﺠﺎوز اﻟﯿﻮم اﻟﺴﺎدس ﻣﻦ اﻟﺸﻬﺮي  \nاﻟﺘﺎﻟﻲ.\n(ب -)اﺗﻔﻖ اﻟﻄﺮﻓﺎن ﻋﻠﻰ ﻣﻨﺢ اﻟﻄﺮف اﻟﺜﺎﻧﻲ إﺿﺎﻓﺔ ﻟﻸﺟﺮ اﻟﺸﻬﺮي اﻟﻤﺰاﯾﺎ اﻟﻨﻘﺪﯾﺔ أو اﻟﻌﯿﻨﯿﺔ اﻟﺘﺎﻟﯿﺔ:",
          "variable_ids": []
        }
