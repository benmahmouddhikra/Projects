        "normalized_start": 0,
        "raw_end": 25,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "a371a84cdaf2ecb6f3bd03601a1287e54707ab6305ccc3053a7138de086f62d4"
      },
      "text": "(4) الشروط الخاصة ان وجدت"
    },
    {
      "content_id": "unparsed_0be8996788891f2f2fad",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000022",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 14,
        "normalized_start": 0,
        "raw_end": 14,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "609e09e98c23a6a94cd4b85bfe74e9df2d99e3f6d719f6b35143baf534041b87"
      },
      "text": "(5) خطاب العرض"
    },
    {
      "content_id": "unparsed_62e2afb59a301548fee2",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000023",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 16,
        "normalized_start": 0,
        "raw_end": 16,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "a0693bb96b8dd6d2799d79dea95fd94a318c0dd9c33f50ba8288e49d276cfc7a"
      },
      "text": "(6) خطاب الترسية"
    },
    {
      "content_id": "unparsed_216ab7c99ff32e60a304",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000024",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 115,
        "normalized_start": 5,
        "raw_end": 115,
        "raw_start": 5,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "c039ac1c1acc61f71559e208ac0b3009642740ec3f36782e991c10ef952d4381"
      },
      "text": "تشكل هذه الوثائق وحدة متكاملة , وتعد كل وثيقة منها جزء من العقد بحيث تفسر وتتمم الوثائق المذكورة بعضها بعضاً ."
    },
    {
      "content_id": "unparsed_5f3a7ecb8a8d963acac3",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000026",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 304,
        "normalized_start": 5,
        "raw_end": 304,
        "raw_start": 5,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "e816902109e4cfa1668b54235275235c7cbdbfe97586e5a77f56216a1f2f385e"
      },
      "text": "(( تذكر مدة العقد رقماً وكتابة )) وتبدأ هذه المدة اعتباراً من تاريخ تسليم الموقع للمستأجر/المستثمر خالياً من الشواغل والعوائق بموجب محضر كتابي موقع عليه من قبل مندوبي الطرفين (( يراعى في تحديد المدة نص المادة التاسعة والثلاثين بعد المائة من اللائحة التنفيذية لنظام المنافسات والمشتريات الحكومية )) ."
    },
    {
      "content_id": "unparsed_2f40af1b7ea1f46d07e9",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000028",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 361,
        "normalized_start": 0,
        "raw_end": 361,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "052eb617ce6305e8628aaf1f30c6804e1a63cb3584049fe4a3ec57e9e31c2e27"
      },
      "text": "أ/ إن القيمة الايجارية عن كامل مدة العقد (( تذكر قيمة العقد الإجمالية رقماً وكتابة ))  موزعه على عدد سنوات العقد , وتبلغ الأجرة السنوية (( تذكر قيمة الأجرة السنوية رقماً وكتابة )) وتسدد الأجرة السنوية كاملة خلال عشرة أيام من بداية كل سنه تعاقدية , ويعتبر تاريخ استلام الموقع بداية السنة العقدية ويجوز الاتفاق على تسديد أجرة السنوات المحددة في العقد دفعة واحدة ."
    },
    {
      "content_id": "unparsed_92ba631fd62e404f5949",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000029",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 121,
        "normalized_start": 0,
        "raw_end": 121,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "c447ce34d6e603711ab14cede5fc0693e28bb28a2bcc664c53ddd079aaa799ec"
      },
      "text": "ب/ إذا كان التأجير للاستثمار يعطى المستثمر مدة غير مدفوعة الأجرة  لا تتجاوز 5% من مدة العقد وتبدأ من تاريخ تسليم الموقع ."
    },
    {
      "content_id": "unparsed_216f9a5283ec53f67537",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000031",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 149,
        "normalized_start": 0,
        "raw_end": 149,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "634d7c2d9f7364228bfd037192f8ecc1b2735b68613eacad773d33a81a88e915"
      },
      "text": "يحكم هذا العقد أنظمة المملكة العربية السعودية , وبصفة خاصة نظام المنافسات والمشتريات الحكومية ولائحته التنفيذية , وتعليمات , وتفسيرات وزارة المالية ."
    },
    {
      "content_id": "unparsed_471d8c8d2ab26dd18bea",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000033",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 142,
        "normalized_start": 6,
        "raw_end": 142,
        "raw_start": 6,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "9ec3f755b89c0120593cc59ea3978440d7bc20b91d7d461c91e3b168eb2770ae"
      },
      "text": "كل خلاف ينشأ عن تطبيق هذا العقد , ولايتم التوصل إلى تسويته بين الطرفين تختص المحكمة الإدارية بالفصل فيه ــ ويكون حكمهاً في ذلك نهائياً ."
    },
    {
      "content_id": "unparsed_c86663f91b59b03efa5f",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000034",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 121,
        "normalized_start": 0,
        "raw_end": 121,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "7958420557f7b899fe8d04d5e354d6a90dcb75b1e630eea21bf75caa4c2931e3"
      },
      "text": "وتوثيقاً لما تقدم فقد قام الطرفان المؤجر والمستأجر/المستثمر بالتوقيع على هذه الوثيقة في المكان والتاريخ المذكورين أعلاه ."
    },
    {
      "content_id": "unparsed_72c8999100d206ff1de9",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000035",
        "extraction_id": "ext_6830908e41d82b821899",
        "normalized_end": 15,
        "normalized_start": 0,
        "raw_end": 15,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "9f1bdae6fd1216ed0bd31e4b881f78c72e42547b7b08b5fad986006268f15c2e"
      },
      "text": "والله والموفق ."
    },
    {
      "content_id": "unparsed_67c53e517c16817c6557",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000036",
        "extraction_id": "ext_6830908e41d82b821899",
