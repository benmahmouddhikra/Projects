        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "5e69e7c6e0d9da984481b0967bf1b194259594930acdb22152f7c6f1adae008b"
      },
      "text": "(3) الشروط والمواصفات"
    },
    {
      "content_id": "unparsed_fe954812c5d51cb83306",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000021",
