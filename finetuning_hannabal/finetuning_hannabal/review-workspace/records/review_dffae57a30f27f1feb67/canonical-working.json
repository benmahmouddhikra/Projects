        "normalized_start": 0,
        "raw_end": 29,
        "raw_start": 0,
        "source_id": "src_40588fa342354ceb6b06",
        "text_sha256": "e2cc832636920a03b1825d46420c55f26be94184f58e08c3e37267305e2dec40"
      },
      "text": "(2) الالتزامات والشروط العامة"
    },
    {
      "content_id": "unparsed_aa7e43bb57b2c744fbe6",
      "reason": "no_deterministic_heading_boundary",
      "source_span": {
        "block_id": "block_000020",
