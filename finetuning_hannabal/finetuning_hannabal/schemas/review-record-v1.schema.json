{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hannibal:schema:review-record-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_record_id", "template_id", "source_ids", "queue_status", "reasons", "required_reviews", "decisions", "versions"],
  "properties": {
    "schema_version": {"const": "review-record-v1"},
    "review_record_id": {"type": "string", "pattern": "^review_[a-f0-9]{20}$"},
    "template_id": {"type": ["string", "null"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "queue_status": {"enum": ["pending", "in_review", "approved", "rejected"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_reviews": {"type": "array", "items": {"enum": ["extraction", "classification", "structure", "privacy", "legal", "sanitization"]}},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reviewer", "review_type", "status", "notes"],
        "properties": {
          "reviewer": {"type": "string"},
          "review_type": {"enum": ["extraction", "classification", "structure", "privacy", "legal", "sanitization"]},
          "status": {"enum": ["approved", "rejected", "changes_required"]},
          "notes": {"type": "string"}
        }
      }
    },
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["pipeline", "schema"],
      "properties": {"pipeline": {"type": "string"}, "schema": {"const": "review-record-v1"}}
    }
  }
}
