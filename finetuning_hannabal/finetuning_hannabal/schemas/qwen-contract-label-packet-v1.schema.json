{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hannibal:schema:qwen-contract-label-packet-v1",
  "title": "Compact contract section or clause packet for Qwen labeling",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "template_id", "document_kind", "scope", "section", "clauses", "variables"],
  "properties": {
    "schema_version": {"const": "qwen-contract-label-packet-v1"},
    "packet_id": {"type": "string", "pattern": "^pkt_[a-f0-9]{20}$"},
    "template_id": {"type": "string", "pattern": "^tpl_[a-f0-9]{20}$"},
    "document_kind": {"enum": ["contract_template", "completed_contract"]},
    "scope": {"enum": ["section", "clause"]},
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["section_id", "heading", "kind", "requirement_status"],
      "properties": {
        "section_id": {"type": "string", "pattern": "^sec_[a-f0-9]{20}$"},
        "heading": {"type": ["string", "null"]},
        "kind": {"type": "string"},
        "requirement_status": {"type": "string"}
      }
    },
    "clauses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["clause_id", "heading", "text", "requirement_status", "variable_ids"],
        "properties": {
          "clause_id": {"type": "string", "pattern": "^clause_[a-f0-9]{20}$"},
          "heading": {"type": ["string", "null"]}, "text": {"type": "string", "minLength": 1},
          "requirement_status": {"type": "string"},
          "variable_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["variable_id", "canonical_token", "value_type", "requirement_status"],
        "properties": {
          "variable_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "canonical_token": {"type": "string", "pattern": "^\\[[A-Z][A-Z0-9_]*\\]$"},
          "value_type": {"type": "string"}, "requirement_status": {"type": "string"}
        }
      }
    }
  }
}
